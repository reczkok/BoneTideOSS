{
  "name": "bone-tide",
  "version": "1.0.0",
  "private": true,
  "description": "A WebGPU survivors-like built with TypeGPU",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "types": "pnpm -r run types",
    "test": "pnpm -r --if-present run test",
    "web": "pnpm --filter @bonetide/web dev",
    "web:host": "pnpm --filter @bonetide/web dev:host",
    "ios": "pnpm --filter @bonetide/mobile ios",
    "android": "pnpm --filter @bonetide/mobile android"
  },
  "devDependencies": {
    "eslint-plugin-typegpu": "^0.12.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "npm:tsover@6.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.13.0"
}
